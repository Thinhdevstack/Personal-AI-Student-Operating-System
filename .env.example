# Personal AI Student OS - Environment Variables
# Copy to .env or .env.local for local overrides.

# Server-only keys. Leave unused providers blank. Never put keys in NEXT_PUBLIC_*.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Default chat provider; the Course Chat selector can override it per question.
AI_CHAT_PROVIDER=openai
# Embeddings are independent from chat. Supported: openai, gemini, ollama.
# A Gemini-only setup should set both providers to gemini.
AI_EMBEDDING_PROVIDER=openai

# OpenAI embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Bump when intentionally rebuilding the same model alias with a new index identity.
OPENAI_EMBEDDING_VERSION=

# Responses API model for Course Tutor (must support structured outputs).
OPENAI_CHAT_MODEL=gpt-5-mini
GEMINI_CHAT_MODEL=gemini-3.6-flash
DEEPSEEK_CHAT_MODEL=deepseek-flash

GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_VERSION=

# Explicit test/offline mode only. Replies are marked simulated in the UI.
# Never use mock embeddings as evidence of working live semantic retrieval.
AI_OFFLINE_MODE=0

# No-key Student simulation: npm run dev:student-demo, or build:student-demo then start:student-demo.
# The launcher forces mock providers and separate data/student-demo storage after loading this file.

# Local study: npm run build:student-local, then npm run start:student-local (port 4312).
# Install/pull models separately; local mode never silently falls back to simulation or a paid API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_EMBEDDING_VERSION=
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TIMEOUT_MS=180000
