# Personal AI Student OS - Environment Variables
# Copy to .env or .env.local for local overrides.

# Server-only OpenAI API key for embeddings and Course Tutor.
OPENAI_API_KEY=

# OpenAI embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Bump when intentionally rebuilding the same model alias with a new index identity.
OPENAI_EMBEDDING_VERSION=

# Responses API model for Course Tutor (must support structured outputs).
OPENAI_CHAT_MODEL=gpt-5-mini

# Explicit test/offline mode only. Replies are marked simulated in the UI.
# Never use mock embeddings as evidence of working live semantic retrieval.
AI_OFFLINE_MODE=0

