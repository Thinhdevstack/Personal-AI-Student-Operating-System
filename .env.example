# Personal AI Student OS - Environment Variables
# Copy to .env or .env.local for local overrides.

# Server-only keys. Leave unused providers blank. Never put keys in NEXT_PUBLIC_*.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Default chat provider; the Course Chat selector can override it per question.
AI_CHAT_PROVIDER=openai
# Embeddings are independent from chat. Supported: openai, gemini.
# A Gemini-only setup should set both providers to gemini.
AI_EMBEDDING_PROVIDER=openai

# OpenAI embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Bump when intentionally rebuilding the same model alias with a new index identity.
OPENAI_EMBEDDING_VERSION=

# Responses API model for Course Tutor (must support structured outputs).
OPENAI_CHAT_MODEL=gpt-5-mini
GEMINI_CHAT_MODEL=gemini-3.6-flash
DEEPSEEK_CHAT_MODEL=deepseek-flash

GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_VERSION=

# Explicit test/offline mode only. Replies are marked simulated in the UI.
# Never use mock embeddings as evidence of working live semantic retrieval.
AI_OFFLINE_MODE=0

